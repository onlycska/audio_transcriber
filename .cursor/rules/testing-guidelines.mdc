### 2. Parametrized Tests
```python
# tests/unit/test_domain/test_entities/test_act.py
@pytest.mark.parametrize("sign_type,expected", [
    (SignType.ELECTRONIC, "electronic"),
    (SignType.DIGITAL, "digital"),
    (SignType.MANUAL, "manual"),
])
def test_sign_type_values(sign_type, expected):
    """Test sign type string values"""
    assert str(sign_type) == expected


@pytest.mark.parametrize("webmaster_id,should_raise", [
    (123, False),
    (0, True),
    (-1, True),
    (1000000, False),
])
def test_webmaster_id_validation(webmaster_id, should_raise):
    """Test webmaster ID validation"""
    if should_raise:
        with pytest.raises(ValueError):
            PaymentRequest(webmaster_id=webmaster_id, request_id="req_123")
    else:
        payment_request = PaymentRequest(webmaster_id=webmaster_id, request_id="req_123")
        assert payment_request.webmaster_id == webmaster_id
```

