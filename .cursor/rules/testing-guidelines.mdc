# tests/integration/test_presentation/test_api/test_routes/test_acts_integration.py
import datetime
import pytest
from fastapi.testclient import TestClient

from webmasters.presentation.api.app import create_app
from webmasters.presentation.api.settings import ApiSettings
from tests.mock.mock_di import mock_container


class TestActsIntegration:
    """Integration tests for acts"""

    @pytest.fixture
    def app_settings(self):
        """Fixture with settings"""
        return ApiSettings(debug=True)

    @pytest.fixture
    def app(self, app_settings):
        """Fixture with the application"""
        app = create_app(app_settings)
        # Replace DI container with mock
        app.state.di_container = mock_container
        return app

    @pytest.fixture
    def client(self, app):
        """Fixture with the test client"""
        return TestClient(app)

    def test_create_act_full_flow(self, client):
        """Test full flow of act creation"""
        # Arrange
        request_data = {
            "webmaster_id": 123,
            "payment_request_id": "req_123",
            "fines": [1, 2],
            "rewards": [3, 4],
            "sign_type": "electronic",
            "sign_status": "signed",
            "sign_date": datetime.datetime.now().isoformat(),
            "uid": "uuid_123",
            "doc_url": "https://example.com/doc.pdf",
        }

        # Act
        response = client.post("/api/v1/acts", json=request_data)

        # Assert
        assert response.status_code == 201
        data = response.json()
        assert data["webmaster_id"] == 123
        assert data["payment_request_id"] == "req_123"

        # Check that the act can be retrieved
        get_response = client.get(f"/api/v1/acts/{data['id']}")
        assert get_response.status_code == 200
        get_data = get_response.json()
        assert get_data["id"] == data["id"]

    def test_get_fines_with_filters(self, client):
        """Test retrieving fines with filters"""
        # Act
        response = client.get(
            "/api/v1/fines",
            params={
                "webmaster_id": 123,
                "limit": 10,
                "offset": 0,
                "order": "asc",
                "sort": "created_at",
            }
        )

        # Assert
        assert response.status_code == 200
        data = response.json()
        assert "count" in data
        assert "items" in data
        assert "limit" in data
        assert "offset" in data
        assert data["limit"] == 10
        assert data["offset"] == 0
