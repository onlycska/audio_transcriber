# tests/unit/test_presentation/test_api/test_routes/test_acts.py
import datetime
import pytest
from fastapi.testclient import TestClient
from unittest.mock import AsyncMock, MagicMock

from webmasters.presentation.api.app import create_app
from webmasters.presentation.api.settings import ApiSettings


class TestActsRoutes:
    """Tests for act routes"""

    @pytest.fixture
    def app_settings(self):
        """Fixture with application settings"""
        return ApiSettings(
            debug=True,
            cors_origins=["*"],
        )

    @pytest.fixture
    def app(self, app_settings):
        """Fixture with the application"""
        return create_app(app_settings)

    @pytest.fixture
    def client(self, app):
        """Fixture with the test client"""
        return TestClient(app)

    def test_create_act_positive(self, client):
        """Positive test: successful act creation"""
        # Arrange
        request_data = {
            "webmaster_id": 123,
            "payment_request_id": "req_123",
            "fines": [1, 2],
            "rewards": [3, 4],
            "sign_type": "electronic",
            "sign_status": "signed",
            "sign_date": datetime.datetime.now().isoformat(),
            "uid": "uuid_123",
            "doc_url": "https://example.com/doc.pdf",
        }

        # Act
        response = client.post("/api/v1/acts", json=request_data)

        # Assert
        assert response.status_code == 201
        data = response.json()
        assert data["webmaster_id"] == 123
        assert data["payment_request_id"] == "req_123"
        assert data["sign_type"] == "electronic"
        assert data["sign_status"] == "signed"

    def test_create_act_validation_error(self, client):
        """Negative test: validation error when creating an act"""
        # Arrange
        invalid_request_data = {
            "webmaster_id": -1,  # Invalid ID
            "payment_request_id": "",  # Empty string
            "sign_type": "invalid_type",  # Invalid type
        }

        # Act
        response = client.post("/api/v1/acts", json=invalid_request_data)

        # Assert
        assert response.status_code == 422
        data = response.json()
        assert "error" in data
        assert data["error"] == "ValidationError"

    def test_get_act_positive(self, client):
        """Positive test: successful act retrieval"""
        # Act
        response = client.get("/api/v1/acts/1")

        # Assert
        assert response.status_code == 200
        data = response.json()
        assert "id" in data
        assert "webmaster_id" in data

    def test_get_act_not_found(self, client):
        """Negative test: getting a non-existing act"""
        # Act
        response = client.get("/api/v1/acts/999")

        # Assert
        assert response.status_code == 404
        data = response.json()
        assert data["error"] == "ActNotFound"
