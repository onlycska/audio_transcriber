## Mock Object Guidelines

### 1. Mock DI Container
```python
# tests/mock/mock_di.py
import di
from di import dependent
from unittest.mock import AsyncMock, MagicMock

from webmasters.service.interfaces.factories.uow_factory import UowFactory
from webmasters.service.interfaces.read_models.fines import IFinesReadModelFactory
from webmasters.service.interfaces.read_models.rewards import IRewardsReadModelFactory
from webmasters.service.interfaces.gateways.legacy_billing_gateway import ILegacyBillingGateway

# Create mock container
mock_container = di.Container()

# Mock UoW Factory
mock_uow_factory = AsyncMock(spec=UowFactory)
mock_uow_factory.return_value = AsyncMock()

mock_container.bind(
    di.bind_by_type(
        dependent.Dependent(mock_uow_factory, scope="request"),
        UowFactory,
    ),
)

# Mock Read Model Factories
mock_fines_read_model_factory = AsyncMock(spec=IFinesReadModelFactory)
mock_fines_read_model_factory.return_value = AsyncMock()

mock_container.bind(
    di.bind_by_type(
        dependent.Dependent(mock_fines_read_model_factory, scope="request"),
        IFinesReadModelFactory,
    ),
)

# Mock Gateway
mock_gateway = AsyncMock(spec=ILegacyBillingGateway)

mock_container.bind(
    di.bind_by_type(
        dependent.Dependent(mock_gateway, scope="request"),
        ILegacyBillingGateway,
    ),
)
```

