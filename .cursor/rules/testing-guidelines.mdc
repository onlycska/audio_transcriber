# Testing Guidelines

## General Testing Principles

### 1. Testing Pyramid
- **Unit tests** (70%) - fast, isolated component tests
- **Integration tests** (20%) - tests of interaction between layers
- **E2E tests** (10%) - full user flow tests

### 2. Principles of Good Tests
- **FIRST**: Fast, Independent, Repeatable, Self-validating, Timely
- **AAA**: Arrange, Act, Assert
- **One test = one assertion**
- **Readable test names**
- **Tests should be split into positive and negative. The test name must include the word `positive` or `negative`**
- **Each test must include a docstring describing exactly what it verifies**
- **Tests must not depend on other tests**
- **Tests must not depend on configuration**
- **Tests must not depend on external resources**
- **Tests must not depend on time**
- **Tests must not depend on system state**
- **Tests must be isolated**

## Test Structure

**The test structure must mirror the application structure.**
```
tests/
├── unit/                     # Unit tests
│   ├── test_domain/          # Domain layer tests
│   ├── test_service/         # Service layer tests
│   ├── test_infrastructure/  # Infrastructure layer tests
│   └── test_presentation/    # Presentation layer tests
├── integration/              # Integration tests
├── mock/                     # Mock objects and fixtures
└── conftest.py               # Shared fixtures
```

## Unit Test Guidelines

### 1. Domain Layer Tests
```python
# tests/unit/test_domain/test_entities/test_act.py
import datetime
import decimal
import pytest

from webmasters.domain.entities.act import Act
from webmasters.domain.entities.fine import Fine
from webmasters.domain.entities.reward import Reward
from webmasters.domain.value_objects.payment import PaymentRequest
from webmasters.domain.value_objects.sign_info import SignInfo
from webmasters.domain.enums import SignType, SignStatus


class TestAct:
    """Tests for the Act aggregate"""

    @pytest.fixture
    def sample_act(self):
        """Fixture with a sample act"""
        return Act(
            payment_request=PaymentRequest(
                webmaster_id=123,
                request_id="req_123",
            ),
            fines=[Fine(fine_id=1), Fine(fine_id=2)],
            rewards=[Reward(reward_id=3)],
            sign_info=SignInfo(
                signed_at=datetime.datetime.now(),
                sign_type=SignType.ELECTRONIC,
                sign_status=SignStatus.SIGNED,
                pep_uuid="uuid_123",
                signed_doc_url="https://example.com/doc.pdf",
            ),
        )

    def test_act_creation_positive(self, sample_act):
        """Positive test: successful act creation"""
        # Arrange
        webmaster_id = 123
        request_id = "req_123"

        # Act
        act = Act(
            payment_request=PaymentRequest(
                webmaster_id=webmaster_id,
                request_id=request_id,
            ),
            fines=[],
            rewards=[],
            sign_info=SignInfo(
                signed_at=datetime.datetime.now(),
                sign_type=SignType.ELECTRONIC,
                sign_status=SignStatus.DRAFT,
                pep_uuid="uuid_123",
            ),
        )

        # Assert
        assert act.payment_request.webmaster_id == webmaster_id
        assert act.payment_request.request_id == request_id
        assert act.fines == []
        assert act.rewards == []
        assert act.sign_info.sign_type == SignType.ELECTRONIC
        assert act.sign_info.sign_status == SignStatus.DRAFT

    def test_add_fine_positive(self, sample_act):
        """Positive test: adding a fine to an act"""
        # Arrange
        new_fine = Fine(fine_id=3)
        initial_fines_count = len(sample_act.fines)

        # Act
        sample_act.add_fine(new_fine)

        # Assert
        assert len(sample_act.fines) == initial_fines_count + 1
        assert new_fine in sample_act.fines
        assert sample_act.version == 1

    def test_add_fine_duplicate_negative(self, sample_act):
        """Negative test: adding a duplicate fine"""
        # Arrange
        duplicate_fine = Fine(fine_id=1)  # Already exists in sample_act

        # Act & Assert
        with pytest.raises(ValueError, match="Fine already added to act"):
            sample_act.add_fine(duplicate_fine)

    def test_add_fine_signed_act_negative(self, sample_act):
        """Negative test: adding a fine to a signed act"""
        # Arrange
        sample_act.sign(sample_act.sign_info)
        new_fine = Fine(fine_id=3)

        # Act & Assert
        with pytest.raises(ValueError, match="Cannot add fines to non-draft act"):
            sample_act.add_fine(new_fine)

    def test_sign_act_positive(self, sample_act):
        """Positive test: signing an act"""
        # Arrange
        sign_info = SignInfo(
            signed_at=datetime.datetime.now(),
            sign_type=SignType.DIGITAL,
            sign_status=SignStatus.SIGNED,
            pep_uuid="uuid_456",
            signed_doc_url="https://example.com/signed_doc.pdf",
        )

        # Act
        sample_act.sign(sign_info)

        # Assert
        assert sample_act.sign_info.sign_type == SignType.DIGITAL
        assert sample_act.sign_info.sign_status == SignStatus.SIGNED
        assert sample_act.sign_info.pep_uuid == "uuid_456"
        assert sample_act.version == 1

    def test_sign_act_already_signed_negative(self, sample_act):
        """Negative test: signing an already signed act"""
        # Arrange
        sample_act.sign(sample_act.sign_info)
        new_sign_info = SignInfo(
            signed_at=datetime.datetime.now(),
            sign_type=SignType.DIGITAL,
            sign_status=SignStatus.SIGNED,
            pep_uuid="uuid_789",
        )

        # Act & Assert
        with pytest.raises(ValueError, match="Act is already signed"):
            sample_act.sign(new_sign_info)
```

### 2. Service Layer Tests
```python
# tests/unit/test_service/test_handlers/test_commands/test_create_act.py
import datetime
import pytest
from unittest.mock import AsyncMock, MagicMock

from webmasters.service.handlers.commands.acts.create_act import CreateActCommandHandler
from webmasters.service.models.commands.acts.create_act import CreateActCommand, CreateActCommandResult
from webmasters.service.interfaces.factories.uow_factory import UowFactory
from webmasters.service.interfaces.repositories.acts import IActsRepository


class TestCreateActCommandHandler:
    """Tests for CreateActCommandHandler"""

    @pytest.fixture
    def mock_uow_factory(self):
        """Fixture with a mock UoW factory"""
        return AsyncMock(spec=UowFactory)

    @pytest.fixture
    def mock_acts_repository(self):
        """Fixture with a mock acts repository"""
        return AsyncMock(spec=IActsRepository)

    @pytest.fixture
    def mock_uow(self, mock_acts_repository):
        """Fixture with a mock UoW"""
        uow = AsyncMock()
        uow.transaction.return_value.__aenter__.return_value = mock_acts_repository
        return uow

    @pytest.fixture
    def handler(self, mock_uow_factory):
        """Fixture with the command handler"""
        return CreateActCommandHandler(mock_uow_factory)

    @pytest.fixture
    def sample_command(self):
        """Fixture with a sample command"""
        return CreateActCommand(
            webmaster_id=123,
            payment_request_id="req_123",
            fines=[1, 2],
            rewards=[3, 4],
            sign_type="electronic",
            sign_status="signed",
            sign_date=datetime.datetime.now(),
            uid="uuid_123",
            doc_url="https://example.com/doc.pdf",
        )

    async def test_handle_positive(self, handler, mock_uow_factory, mock_uow, mock_acts_repository, sample_command):
        """Positive test: successful command execution"""
        # Arrange
        mock_uow_factory.return_value = mock_uow
        mock_created_act = MagicMock()
        mock_created_act.act_id = 1
        mock_created_act.payment_request.webmaster_id = 123
        mock_created_act.payment_request.request_id = "req_123"
        mock_created_act.sign_info.sign_type.value = "electronic"
        mock_created_act.sign_info.sign_status.value = "signed"
        mock_created_act.sign_info.signed_at = datetime.datetime.now()
        mock_created_act.sign_info.pep_uuid = "uuid_123"
        mock_created_act.sign_info.signed_doc_url = "https://example.com/doc.pdf"
        mock_created_act.created_at = datetime.datetime.now()
        mock_created_act.updated_at = datetime.datetime.now()
        mock_acts_repository.create.return_value = mock_created_act

        # Act
        result = await handler.handle(sample_command)

        # Assert
        assert isinstance(result, CreateActCommandResult)
        assert result.id == 1
        assert result.webmaster_id == 123
        assert result.payment_request_id == "req_123"
        assert result.sign_type == "electronic"
        assert result.sign_status == "signed"
        assert result.uid == "uuid_123"
        assert result.doc_url == "https://example.com/doc.pdf"

        # Check calls
        mock_uow_factory.assert_called_once()
        mock_acts_repository.create.assert_called_once()

    async def test_handle_act_without_id_negative(self, handler, mock_uow_factory, mock_uow, mock_acts_repository, sample_command):
        """Negative test: error when created act has no ID"""
        # Arrange
        mock_uow_factory.return_value = mock_uow
        mock_created_act = MagicMock()
        mock_created_act.act_id = None  # No ID

        mock_acts_repository.create.return_value = mock_created_act

        # Act & Assert
        with pytest.raises(ValueError, match="Created act has no ID"):
            await handler.handle(sample_command)

    async def test_handle_empty_fines_and_rewards_negative(self, handler, sample_command):
        """Negative test: error when fines and rewards are empty"""
        # Arrange
        command_without_data = CreateActCommand(
            webmaster_id=123,
            payment_request_id="req_123",
            fines=[],  # Empty list
            rewards=[],  # Empty list
            sign_type="electronic",
            sign_status="signed",
            sign_date=datetime.datetime.now(),
        )

        # Act & Assert
        with pytest.raises(ValueError, match="Act must have at least one fine or reward"):
            await handler.handle(command_without_data)
```

### 3. Infrastructure Layer Tests
```python
# tests/unit/test_infrastructure/test_gateways/test_http_legacy_billing_gateway.py
import datetime
import pytest
from unittest.mock import AsyncMock, MagicMock
import httpx

from webmasters.infrastructure.gateways.legacy_billing.http_legacy_billing_gateway import HttpLegacyBillingGateway
from webmasters.domain.entities.act import Act
from webmasters.domain.value_objects.payment import PaymentRequest
from webmasters.domain.value_objects.sign_info import SignInfo
from webmasters.domain.enums import SignType, SignStatus
from webmasters.service.errors import ActNotFound, LegacyBillingError


class TestHttpLegacyBillingGateway:
    """Tests for HttpLegacyBillingGateway"""

    @pytest.fixture
    def mock_http_client(self):
        """Fixture with a mock HTTP client"""
        return AsyncMock(spec=httpx.AsyncClient)

    @pytest.fixture
    def mock_settings(self):
        """Fixture with mock settings"""
        settings = MagicMock()
        settings.base_url = "https://api.example.com"
        settings.timeout = 30
        return settings

    @pytest.fixture
    def gateway(self, mock_http_client, mock_settings):
        """Fixture with the gateway"""
        return HttpLegacyBillingGateway(mock_http_client, mock_settings)

    @pytest.fixture
    def sample_act(self):
        """Fixture with a sample act"""
        return Act(
            payment_request=PaymentRequest(
                webmaster_id=123,
                request_id="req_123",
            ),
            fines=[],
            rewards=[],
            sign_info=SignInfo(
                signed_at=datetime.datetime.now(),
                sign_type=SignType.ELECTRONIC,
                sign_status=SignStatus.SIGNED,
                pep_uuid="uuid_123",
                signed_doc_url="https://example.com/doc.pdf",
            ),
        )

    async def test_create_act_positive(self, gateway, mock_http_client, sample_act):
        """Positive test: successful act creation"""
        # Arrange
        mock_response = MagicMock()
        mock_response.status_code = 201
        mock_response.json.return_value = {
            "id": 1,
            "webmaster_id": 123,
            "payment_request_id": "req_123",
            "fines": [],
            "rewards": [],
            "sign_info": {
                "signed_at": datetime.datetime.now().isoformat(),
                "sign_type": "electronic",
                "sign_status": "signed",
                "pep_uuid": "uuid_123",
                "signed_doc_url": "https://example.com/doc.pdf",
            },
            "created_at": datetime.datetime.now().isoformat(),
            "updated_at": datetime.datetime.now().isoformat(),
        }

        mock_http_client.post.return_value = mock_response

        # Act
        result = await gateway.create_act(sample_act)

        # Assert
        assert result.act_id == 1
        assert result.payment_request.webmaster_id == 123
        assert result.payment_request.request_id == "req_123"
        assert result.sign_info.sign_type == SignType.ELECTRONIC
        assert result.sign_info.sign_status == SignStatus.SIGNED

        # Check HTTP client call
        mock_http_client.post.assert_called_once()
        call_args = mock_http_client.post.call_args
        assert call_args[0][0] == "https://api.example.com/api/v1/acts"
        assert call_args[1]["timeout"] == 30

    async def test_create_act_404_error(self, gateway, mock_http_client, sample_act):
        """Negative test: 404 error when creating an act"""
        # Arrange
        mock_response = MagicMock()
        mock_response.status_code = 404
        mock_response.text = "Act not found"

        mock_http_client.post.side_effect = httpx.HTTPStatusError(
            "Not Found",
            request=MagicMock(),
            response=mock_response,
        )

        # Act & Assert
        with pytest.raises(ActNotFound, match="Act not found: Act not found"):
            await gateway.create_act(sample_act)

    async def test_create_act_network_error(self, gateway, mock_http_client, sample_act):
        """Negative test: network error when creating an act"""
        # Arrange
        mock_http_client.post.side_effect = httpx.RequestError("Network error")

        # Act & Assert
        with pytest.raises(LegacyBillingError, match="Request failed: Network error"):
            await gateway.create_act(sample_act)
```

